{
  "name": "grouped-tools",
  "displayName": "Ferramentas agrupadas",
  "description": "Painel compacto de ferramentas com grupos, busca e favoritos.",
  "version": "0.0.4",
  "publisher": "local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "scripts": {
    "check": "node -e \"const fs=require('fs'),cp=require('child_process');for(const f of [...fs.readdirSync('src',{recursive:true}).filter(f=>f.endsWith('.js')).map(f=>'src/'+f),'media/view.js'])cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "test": "node --test \"test/*.test.js\""
  },
  "contributes": {
    "commands": [
      {
        "command": "groupedTools.run",
        "title": "Ferramentas: abrir item"
      },
      {
        "command": "groupedTools.configure",
        "title": "Ferramentas: configurar grupos",
        "icon": "$(gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "groupedTools",
          "title": "Ferramentas",
          "icon": "media/tools.svg"
        }
      ]
    },
    "views": {
      "groupedTools": [
        {
          "id": "groupedTools.view",
          "name": "Ferramentas",
          "type": "webview",
          "icon": "media/tools.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "groupedTools.configure",
          "when": "view == groupedTools.view",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ferramentas agrupadas",
      "properties": {
        "groupedTools.groups": {
          "type": "array",
          "scope": "window",
          "default": [
            {
              "name": "IA e assistentes",
              "icon": "sparkle",
              "items": [
                {
                  "name": "Localizar comando de IA",
                  "command": "workbench.action.showCommands",
                  "icon": "terminal"
                }
              ]
            },
            {
              "name": "Cloud e infraestrutura",
              "icon": "cloud",
              "items": [
                {
                  "name": "Abrir terminal",
                  "command": "workbench.action.terminal.toggleTerminal",
                  "icon": "terminal"
                },
                {
                  "name": "Executar tarefa",
                  "command": "workbench.action.tasks.runTask",
                  "icon": "play"
                }
              ]
            },
            {
              "name": "Qualidade e testes",
              "icon": "beaker",
              "items": [
                {
                  "name": "Problemas",
                  "command": "workbench.actions.view.problems",
                  "icon": "warning"
                },
                {
                  "name": "Testes",
                  "command": "workbench.view.testing.focus",
                  "icon": "beaker"
                }
              ]
            },
            {
              "name": "Variados",
              "icon": "plus",
              "items": [
                {
                  "name": "Spotify",
                  "command": "workbench.view.extension.vscode-spotify",
                  "icon": "music"
                },
                {
                  "name": "ClickUp",
                  "command": "workbench.view.extension.clickup-kanban-sidebar-view",
                  "icon": "kanban"
                }
              ]
            }
          ],
          "description": "Grupos e comandos. A ordem do JSON determina a ordem exibida.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "command"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1
                    },
                    "icon": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
