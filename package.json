          "when": "false"
        },
        {
          "command": "groupedTools.runById",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "group tools",
      "properties": {
        "groupedTools.groups": {
          "type": "array",
          "scope": "window",
          "default": [
            {
              "id": "qualidade-testes",
              "name": "Qualidade e testes",
              "icon": "beaker",
              "color": "g-7",
              "items": [
                {
                  "name": "Problemas",
                  "command": "workbench.actions.view.problems",
                  "icon": "warning"
                },
                {
                  "name": "Testes",
                  "command": "workbench.view.testing.focus",
                  "icon": "beaker"
                }
              ]
            }
          ],
          "description": "Grupos e comandos. A ordem do JSON determina a ordem exibida. O padrão traz só o grupo Qualidade e testes; o restante você cria no painel.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,64}$",
                "description": "Identificador estável do grupo (gerado pelo painel)."
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "icon": {
                "type": "string",
                "description": "Nome de um ícone Lucide (ex.: database)."
              },
              "color": {
                "description": "Cor do grupo: paleta fixa g-1..g-10 ou uma cor própria no formato #rrggbb (minúsculas).",
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "g-1",
                      "g-2",
                      "g-3",
                      "g-4",
                      "g-5",
                      "g-6",
                      "g-7",
                      "g-8",
                      "g-9",
                      "g-10"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  }
                ]
              },
              "pinned": {
                "type": "boolean",
                "description": "Fixa o grupo na barra de atividades e na barra de status. Vale só na configuração do usuário (Global); o ícone do grupo precisa estar no catálogo de ícones fixáveis e só um grupo pode usar cada ícone."
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "command"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "description": "Comando do VS Code. Não pode ser groupedTools.run, runById, openGroup ou manageGroup. Em configuração do projeto, itens com argumentos ou fora de workbench.view.* e workbench.action.* pedem confirmação antes de executar."
                    },
                    "icon": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array"
                    },
                    "extensionId": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*\\.[A-Za-z0-9][A-Za-z0-9._-]*$",
                      "description": "Extensão dona do atalho (usada para detectar atalhos quebrados)."
                    }
                  }
                }
              }
            }
          },
          "maxItems": 100
        }
      }
    },
    "keybindings": [
      {
        "command": "groupedTools.toggleFold",
        "key": "alt+shift+c",
        "when": "focusedView == groupedTools.view"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ]
}
