{
  "name": "grouped-tools",
  "displayName": "Ferramentas agrupadas",
  "description": "Painel compacto de ferramentas com grupos, busca e favoritos.",
  "version": "0.0.4",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/allankltsn/vscode-grouped-tools-extension.git"
  },
  "bugs": {
    "url": "https://github.com/allankltsn/vscode-grouped-tools-extension/issues"
  },
  "homepage": "https://github.com/allankltsn/vscode-grouped-tools-extension#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "tools",
    "groups",
    "favorites",
    "sidebar",
    "launcher"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./src/extension.js",
  "scripts": {
    "check": "node -e \"const fs=require('fs'),cp=require('child_process');for(const f of [...fs.readdirSync('src',{recursive:true}).filter(f=>f.endsWith('.js')).map(f=>'src/'+f),'media/view.js'])cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "test": "node --test \"test/*.test.js\""
  },
  "contributes": {
    "commands": [
      {
        "command": "groupedTools.run",
        "title": "Ferramentas: abrir item"
      },
      {
        "command": "groupedTools.configure",
        "title": "Ferramentas: configurar grupos",
        "icon": "$(gear)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "groupedTools",
          "title": "Ferramentas",
          "icon": "media/tools.svg"
        }
      ]
    },
    "views": {
      "groupedTools": [
        {
          "id": "groupedTools.view",
          "name": "Ferramentas",
          "type": "webview",
          "icon": "media/tools.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "groupedTools.configure",
          "when": "view == groupedTools.view",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ferramentas agrupadas",
      "properties": {
        "groupedTools.groups": {
          "type": "array",
          "scope": "window",
          "default": [
            {
              "name": "Claude e IA",
              "icon": "sparkle",
              "items": [
                {
                  "name": "Claude Code",
                  "command": "workbench.view.extension.claude-sidebar",
                  "icon": "sparkle"
                },
                {
                  "name": "Claude Code: sessões",
                  "command": "workbench.view.extension.claude-sessions-sidebar",
                  "icon": "sparkle"
                },
                {
                  "name": "Claude Code Chat",
                  "command": "workbench.view.extension.claude-code-chat",
                  "icon": "sparkle"
                },
                {
                  "name": "Claude Control",
                  "command": "workbench.view.extension.claudeControl",
                  "icon": "settings"
                },
                {
                  "name": "Claude Lens",
                  "command": "workbench.view.extension.claude-lens",
                  "icon": "search"
                },
                {
                  "name": "Claude Lens (uso)",
                  "command": "workbench.view.extension.claudeLens",
                  "icon": "search"
                },
                {
                  "name": "Claude Code Graph",
                  "command": "workbench.view.extension.claudeIntel",
                  "icon": "code"
                },
                {
                  "name": "Codex (OpenAI)",
                  "command": "workbench.view.extension.codexViewContainer",
                  "icon": "terminal"
                },
                {
                  "name": "Codex Build",
                  "command": "workbench.view.extension.codex-sidebar-view",
                  "icon": "terminal"
                },
                {
                  "name": "CodeCursor",
                  "command": "workbench.view.extension.aicursor",
                  "icon": "sparkle"
                },
                {
                  "name": "Tabnine AI",
                  "command": "workbench.view.extension.tabnine",
                  "icon": "sparkle"
                }
              ]
            },
            {
              "name": "Git e GitHub",
              "icon": "code",
              "items": [
                {
                  "name": "Controle de código-fonte",
                  "command": "workbench.view.scm",
                  "icon": "code"
                },
                {
                  "name": "GitLens",
                  "command": "workbench.view.extension.gitlens",
                  "icon": "code"
                },
                {
                  "name": "GitLens: inspecionar",
                  "command": "workbench.view.extension.gitlensInspect",
                  "icon": "search"
                },
                {
                  "name": "Pull requests e issues",
                  "command": "workbench.view.extension.github-pull-requests",
                  "icon": "code"
                },
                {
                  "name": "GitHub Actions",
                  "command": "workbench.view.extension.github-actions",
                  "icon": "play"
                },
                {
                  "name": "Git Graph",
                  "command": "git-graph.view",
                  "icon": "code"
                }
              ]
            },
            {
              "name": "Bancos de dados",
              "icon": "database",
              "items": [
                {
                  "name": "Database Client",
                  "command": "workbench.view.extension.github-cweijan-mysql",
                  "icon": "database"
                },
                {
                  "name": "Database Client: serviços",
                  "command": "workbench.view.extension.github-cweijan-nosql",
                  "icon": "database"
                },
                {
                  "name": "Histórico SQL",
                  "command": "workbench.view.extension.github-dbclient-history",
                  "icon": "search"
                },
                {
                  "name": "PostgreSQL",
                  "command": "workbench.view.extension.pgObjectExplorer",
                  "icon": "database"
                },
                {
                  "name": "Prisma",
                  "command": "workbench.view.extension.prismaActivitybar",
                  "icon": "database"
                }
              ]
            },
            {
              "name": "Containers e remoto",
              "icon": "cloud",
              "items": [
                {
                  "name": "Containers (Docker)",
                  "command": "workbench.view.extension.containersView",
                  "icon": "cloud"
                },
                {
                  "name": "Explorador remoto",
                  "command": "workbench.view.remote",
                  "icon": "cloud"
                },
                {
                  "name": "Abrir terminal",
                  "command": "workbench.action.terminal.toggleTerminal",
                  "icon": "terminal"
                },
                {
                  "name": "Executar tarefa",
                  "command": "workbench.action.tasks.runTask",
                  "icon": "play"
                }
              ]
            },
            {
              "name": "Diagramas e planejamento",
              "icon": "kanban",
              "items": [
                {
                  "name": "Diagram Forge",
                  "command": "workbench.view.extension.diagram-forge",
                  "icon": "kanban"
                },
                {
                  "name": "Archify",
                  "command": "workbench.view.extension.archify",
                  "icon": "kanban"
                },
                {
                  "name": "Kanban Markdown",
                  "command": "workbench.view.extension.kanban-markdown",
                  "icon": "kanban"
                }
              ]
            },
            {
              "name": "Linguagens e notebooks",
              "icon": "code",
              "items": [
                {
                  "name": "Python",
                  "command": "workbench.view.extension.python",
                  "icon": "code"
                },
                {
                  "name": "Jupyter",
                  "command": "workbench.view.extension.jupyter",
                  "icon": "code"
                },
                {
                  "name": "PowerShell",
                  "command": "workbench.view.extension.PowerShell",
                  "icon": "terminal"
                },
                {
                  "name": "Makefile",
                  "command": "workbench.view.extension.makefile__viewContainer",
                  "icon": "code"
                },
                {
                  "name": "Corretor ortográfico",
                  "command": "workbench.view.extension.cspell-info-explorer",
                  "icon": "search"
                }
              ]
            },
            {
              "name": "Qualidade e testes",
              "icon": "beaker",
              "items": [
                {
                  "name": "Problemas",
                  "command": "workbench.actions.view.problems",
                  "icon": "warning"
                },
                {
                  "name": "Testes",
                  "command": "workbench.view.testing.focus",
                  "icon": "beaker"
                }
              ]
            },
            {
              "name": "Variados",
              "icon": "plus",
              "items": [
                {
                  "name": "Spotify",
                  "command": "workbench.view.extension.vscode-spotify",
                  "icon": "music"
                },
                {
                  "name": "ClickUp",
                  "command": "workbench.view.extension.clickup-kanban-sidebar-view",
                  "icon": "kanban"
                }
              ]
            }
          ],
          "description": "Grupos e comandos. A ordem do JSON determina a ordem exibida.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "items"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "icon": {
                "type": "string"
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "command"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "command": {
                      "type": "string",
                      "minLength": 1
                    },
                    "icon": {
                      "type": "string"
                    },
                    "args": {
                      "type": "array"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
