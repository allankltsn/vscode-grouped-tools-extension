{
  "name": "grouped-tools",
  "displayName": "group tools",
  "description": "Painel compacto de ferramentas com grupos, busca, favoritos, organização por arrastar e grupos fixados na barra de atividades.",
  "version": "0.1.1",
  "publisher": "local",
  "repository": {
    "type": "git",
    "url": "https://github.com/allankltsn/vscode-grouped-tools-extension.git"
  },
  "bugs": {
    "url": "https://github.com/allankltsn/vscode-grouped-tools-extension/issues"
  },
  "homepage": "https://github.com/allankltsn/vscode-grouped-tools-extension#readme",
  "categories": [
    "Other"
  ],
  "keywords": [
    "tools",
    "groups",
    "favorites",
    "sidebar",
    "launcher"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Em pastas não confiáveis o painel usa só a configuração global; grupos definidos no projeto são ignorados até confiar na pasta.",
      "restrictedConfigurations": [
        "groupedTools.groups"
      ]
    }
  },
  "main": "./src/extension.js",
  "scripts": {
    "check": "node -e \"const fs=require('fs'),cp=require('child_process');for(const f of [...fs.readdirSync('src',{recursive:true}).filter(f=>f.endsWith('.js')).map(f=>'src/'+f),...fs.readdirSync('media').filter(f=>f.endsWith('.js')&&f!=='icons.js').map(f=>'media/'+f),...fs.readdirSync('scripts').filter(f=>f.endsWith('.js')).map(f=>'scripts/'+f)])cp.execFileSync(process.execPath,['--check',f],{stdio:'inherit'})\"",
    "test": "node --test \"test/*.test.js\"",
    "build:pins": "node scripts/build-pins.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "groupedTools.configure",
        "title": "group tools: configurar grupos",
        "icon": "$(gear)"
      },
      {
        "command": "groupedTools.toggleFold",
        "title": "group tools: recolher ou expandir todos os grupos"
      },
      {
        "command": "groupedTools.openGroup",
        "title": "group tools: abrir grupo"
      },
      {
        "command": "groupedTools.manageGroup",
        "title": "group tools: gerenciar grupo"
      },
      {
        "command": "groupedTools.runById",
        "title": "group tools: abrir item de grupo fixado"
      }
    ],
